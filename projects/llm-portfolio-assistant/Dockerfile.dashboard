# Dockerfile.dashboard
# Lightweight Streamlit dashboard for RAG portfolio assistant

FROM python:3.12-slim

WORKDIR /app

# Install only essential system packages, clean apt cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# Note: removed --no-deps to allow dependencies like blinker to install
RUN pip install --no-cache-dir streamlit requests blinker==1.8.2 && \
    rm -rf /root/.cache/pip

# Copy the Streamlit application
COPY frontend/streamlit_app.py .

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]