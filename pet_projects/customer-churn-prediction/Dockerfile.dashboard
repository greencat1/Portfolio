# ============================================
# DOCKERFILE FOR STREAMLIT DASHBOARD
# ============================================

FROM python:3.11-slim

WORKDIR /app

# Install ALL dashboard dependencies
RUN pip install --no-cache-dir \
    streamlit==1.28.1 \
    requests==2.31.0 \
    pandas==2.1.3 \
    plotly==5.18.0 \
    numpy==1.26.2

# Copy only dashboard folder
COPY app/dashboard/ ./dashboard/

# Environment variable for API endpoint
ENV API_URL=http://api:8000

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]